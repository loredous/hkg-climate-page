<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hkgclimate.app"
    android:versionCode="7"
    android:versionName="1.2.1">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application android:label="Climate Page">
        <uses-library android:name="automotive" android:required="false" />

        <service
            android:name="hkgclimate.app.ClimateService"
            android:exported="true" />

        <activity
            android:name="hkgclimate.app.SettingsActivity"
            android:label="Climate Page">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="hkgclimate.app.PresetEditorActivity"
            android:label="Climate Page preset"
            android:exported="false" />
    </application>
</manifest>
